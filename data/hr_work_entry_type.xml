<odoo>
    <data noupdate="1">
        <!-- Vacaciones-->
        <record id="work_entry_type_paid_cl" model="hr.work.entry.type">
            <field name="name">Vacaciones</field>
            <field name="code">LEAVECL120</field>
            <field name="country_id" ref="base.cl"/>
            <field name="round_days">FULL</field>
            <field name="round_days_type">HALF-UP</field>
            <field name="is_leave">true</field>
            <field name="color">10</field>
        </record>

        <!-- Licencias -->
        <record id="work_entry_type_unpaid_cl" model="hr.work.entry.type">
            <field name="name">Licencias</field>
            <field name="code">LIC</field>
            <field name="country_id" ref="base.cl"/>
            <field name="round_days">FULL</field>
            <field name="round_days_type">HALF-UP</field>
            <field name="is_leave">true</field>
            <field name="color">1</field>
            <field name="unpaid_structure_ids" eval="[(4, ref('l10n_cl_simpledigital_payroll.structure_chile'))]"/>
        </record>

    </data>
</odoo>