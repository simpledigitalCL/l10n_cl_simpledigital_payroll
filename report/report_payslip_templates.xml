<odoo>
    <template id="report_payslip_remove_worked_days" inherit_id="hr_payroll.report_payslip">
        <xpath expr="//div[@id='worked_days_table']" position="replace">
            <div id="worked_days_table" t-if="o.use_worked_day_lines">
                <table class="table table-sm table-borderless">
                    <thead class="o_black_border">
                        <tr>
                            <th id="work_days_header_name">Ganancias</th>
                            <th id="work_days_header_hours" class="text-end">Horas</th>
                            <th id="work_days_header_days" class="text-end">Dias</th>
                        </tr>
                    </thead>

                    <!-- Horas y Días trabajados -->
                    <tbody id="worked_days_lines">
                        <t t-set="worked_days_lines" t-value="o.worked_days_line_ids.filtered(lambda worked_days: worked_days.code != 'OUT')"/>
                            <span t-foreach="worked_days_lines" t-as="worked_days">
                                <tr style="color:none">
                                    <td id="worked_days_name"><span t-out="worked_days.name.replace('(Medio día)', '').strip()"/></td>
                                    <td id="worked_days_hours" class="text-end"><span t-out="round(worked_days.number_of_hours, 2)"/></td>
                                    <td id="worked_days_days" class="text-end"><span t-out="round(worked_days.number_of_days, 2)"/></td>
                                </tr>
                            </span>
                            <span>
                                <t t-set="line_style" t-value="'color:#875A7B;'"/>
                                <t t-set="line_class" t-value="'o_total o_border_bottom fw-bold'"/>
                                <tr style="color:none">
                                    <td t-att-class="line_class" t-att-style="line_style">
                                        <span>Total</span>
                                    </td>
                                    <td id="worked_days_total_hours" t-attf-class="#{line_class} text-end" t-att-style="line_style">
                                        <span t-out="round(sum(worked_days_lines.mapped('number_of_hours')), 2)"/>
                                    </td>
                                    <td id="worked_days_total_days" t-attf-class="#{line_class} text-end" t-att-style="line_style">
                                        <span t-out="round(sum(worked_days_lines.mapped('number_of_days')), 2)"/>
                                    </td>
                                </tr>
                            </span>
                            <!-- Horas extras no pactadas -->
                            <span t-if="o.overtime_hours > 0">
                                <tr style="color:none">
                                    <td>
                                        <span>Horas Extras No Pactadas</span>
                                    </td>
                                    <td id="overtime_hours" class="text-end">
                                        <span t-out="round(o.overtime_hours, 2)"/>
                                    </td>
                                    <td class="text-end">
                                        <span>-</span>
                                    </td>
                                </tr>
                            </span>
                    </tbody>
                </table>
            </div>
        </xpath>

        <xpath expr="//div[@id='to_pay']" position="after">
            <div id="signature_section" class="mt-5">
               <div class="row mt-5">
                    <!-- Firma Empleador -->
                    <div class="col-6 text-justify">
                        <p>
                            <strong>CERTIFICO:</strong> que he recibido a mi entera satisfacción el Saldo Líquido indicado en la presente liquidación y no tengo cargos ni cobro alguno posterior que hacer, por ninguno de los conceptos correspondidos en ella.
                        </p>
                    </div>
                    <!-- Firma Trabajador -->
                    <div class="col-6 text-center">
                        <br/>
                        <div style="border-top:1px solid #000; margin-top:60px; width:80%; margin-left:auto; margin-right:auto;"/>
                        <p>
                            <strong>Firma Trabajador</strong>
                        </p>
                        <p>
                            <span t-field="o.employee_id.name"/>
                        </p>
                        <p>RUN: 
                            <span t-field="o.employee_id.identification_id"/>
                        </p>
                    </div>
                </div>
            </div>
        </xpath>

    </template>
</odoo>
