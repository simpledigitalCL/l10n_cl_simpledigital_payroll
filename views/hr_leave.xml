<odoo>
    <!-- Campo de dias disponibles de la asignacion de vacaciones -->
    <record id="view_hr_leave_form_inherit_allocation_days" model="ir.ui.view">
        <field name="name">hr.leave.form.inherit.allocation.days</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form_manager"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='duration_display']" position="after">
                <field 
                    name="allocation_days_available" readonly="1"
                    invisible="not show_allocation_days_available"
                    help="Cantidad total de días disponibles en la asignación correspondiente."
                />

                <field name="show_allocation_days_available" invisible="1"/>
            </xpath>
        </field>
    </record>   

    <!-- Agregar campo de "Incluir dias habiles" para saber si el tiempo personal toma dias habiles o no -->
    <record id="view_hr_leave_form_inherit_include_business_days" model="ir.ui.view">
        <field name="name">hr.leave.form.inherit.include.business.days</field>
        <field name="model">hr.leave.type</field>
        <field name="inherit_id" ref="hr_holidays.edit_holiday_status_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='include_public_holidays_in_duration']" position="after">
                <field 
                    name="include_business_days"
                />
            </xpath>
        </field>
    </record>
</odoo>